# Android upload keystore credentials, read at prebuild time by
# plugins/withReleaseSigning.js.
#
# Copy this file to .env (or .env.local, which takes precedence) and fill in the
# real values. Both are gitignored; this example file is not.
#
# The keystore itself is never committed. Put keystore.jks in the project root
# when you want to build for Android and the plugin will copy it into
# android/app/ on every prebuild.

KEYSTORE_ALIAS=your-key-alias
KEYSTORE_STORE_PASSWORD=your-keystore-password
KEYSTORE_KEY_PASSWORD=your-key-password

# Optional. Defaults to keystore.jks, resolved from the project root.
# KEYSTORE_FILE=keystore.jks
